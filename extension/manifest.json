{
  "manifest_version": 3,
  "name": "Local Marketplace Extractor",
  "version": "0.1.0",
  "description": "Manually save visible Facebook Marketplace listings to a local SQLite database.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://www.facebook.com/marketplace*",
    "https://facebook.com/marketplace*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/marketplace",
        "https://www.facebook.com/marketplace/*",
        "https://facebook.com/marketplace",
        "https://facebook.com/marketplace/*"
      ],
      "js": ["cover.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace",
        "https://www.facebook.com/marketplace/*",
        "https://facebook.com/marketplace",
        "https://facebook.com/marketplace/*"
      ],
      "js": ["read-item.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:3001/*", "http://localhost:3001/*"],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract Marketplace listings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["teams.png"],
      "matches": ["https://www.facebook.com/*", "https://facebook.com/*"]
    }
  ]
}
